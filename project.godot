; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="IsoCity"
config/description="Isometric City and Interior Sandbox"
config/version="0.8.0"
run/main_scene="res://scenes/builder.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://resources/ui/isocity.svg"

[display]

window/size/viewport_width=1480
window/size/viewport_height=900
window/stretch/mode="disabled"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/isocity/plugin.cfg")

[rendering]

textures/canvas_textures/default_texture_filter=0
