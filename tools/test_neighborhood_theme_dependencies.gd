extends "res://tools/test_neighborhood_theme_workflow.gd"
func run() -> void:
	DirAccess.make_dir_recursive_absolute(OUT);root.size=Vector2i(1480,900);studio=load("res://scenes/builder.tscn").instantiate();studio.storage_enabled=false;root.add_child(studio);await settle();await settle();studio.consumer_shell.dismiss_welcome()
	for mode in ["2d","3d"]:
		studio.switch_mode(mode);studio.documents[mode]=preload("res://scripts/builder/document.gd").new();var doc: RefCounted=studio.current();doc.data=preload("res://scripts/builder/templates.gd").make(mode,"blank");studio.changed();await settle();var ui: RefCounted=studio.neighborhood_tools;studio._command("neighborhood",null);select(ui,"industrial");ui.blocks.value=1;ui.density.value=100;ui.generate();await ready(ui);check(ui.preview_ready,"Dependency fixture has a real completed preview: "+mode)
		if not ui.preview_ready:continue
		var id: String=ui.pending["data"]["objects"][0]["asset"];var descriptor: Dictionary=studio.library.assets[id];var replacement: Dictionary=descriptor.duplicate(true);var path: String=OUT+"private_scene_"+mode+".tscn";var text: String=FileAccess.get_file_as_string(descriptor["path"]);FileAccess.open(path,FileAccess.WRITE).store_string(text);replacement["path"]=path;studio.library.assets[id]=replacement;ui.cancel();ui.show();select(ui,"industrial");ui.blocks.value=1;ui.density.value=100;ui.generate();await ready(ui)
		check(ui.preview_ready and ui.pending["dependencies"].has(path),"Dependency snapshot follows the actual prepared source used by the proposal: "+mode);var before: Dictionary=doc.data.duplicate(true);var history: int=doc.undo_history.size();FileAccess.open(path,FileAccess.WRITE).store_string(text+"\n; changed private test scene\n");ui.commit();check(ui.pending.is_empty() and ui.summary.text.contains("changed") and doc.data==before and doc.undo_history.size()==history,"A real selected scene change rejects stale Apply without altering history or funds: "+mode)
		FileAccess.open(path,FileAccess.WRITE).store_string(text);ui.show();select(ui,"industrial");ui.blocks.value=1;ui.density.value=100;ui.generate();await ready(ui);check(ui.preview_ready,"Restored private source recovers an ordinary preview: "+mode);DirAccess.remove_absolute(ProjectSettings.globalize_path(path));ui.commit();check(ui.pending.is_empty() and ui.summary.text.contains("changed") and doc.data==before and doc.undo_history.size()==history,"Missing selected source is rejected even with an in-memory scene cached: "+mode);FileAccess.open(path,FileAccess.WRITE).store_string(text);studio.library.assets[id]=descriptor;ui.cancel()
		ui.show();select(ui,"village");ui.blocks.value=1;ui.density.value=100;ui.generate();await ready(ui);var older: int=ui.preview_generation;ui.generate();ui.cancel();await settle();check(ui.preview_generation>older and not ui.preview_ready and ui.preview_world==null and ui.pending.is_empty(),"Cancelled newer generation cannot be revived by a late render-readiness callback: "+mode)
	studio.free();await process_frame;await process_frame;print("NEIGHBORHOOD THEME DEPENDENCIES: %d checks, %d failures"%[checks,failures]);quit(1 if failures else 0)
