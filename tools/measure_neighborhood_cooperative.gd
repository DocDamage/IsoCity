extends "res://tools/test_neighborhood_palettes.gd"
const Reference=preload("res://output/verification/asset_expansion/I16/cooperative_merge_before.gd")
func run() -> void:
	library=preload("res://scripts/builder/asset_library.gd").new();var source: Dictionary=preload("res://scripts/builder/templates.gd").make("2d","blank");source["economy"]={"enabled":true,"starting_cash":1000000};source["economy_account"]=Plan.Economy.fresh_account(source,library);var config: Dictionary=Plan.defaults();config.merge({"theme":"village","blocks":1,"density":100,"seed":17,"origin":[0,0]},true);var start: int=Time.get_ticks_usec();var generated: Dictionary=Plan.generate(source,config,library);print("COOP MEASURE generation ms: ",(Time.get_ticks_usec()-start)/1000.0);check(generated["ok"],"Measured proposal is an actual district")
	if not generated["ok"]:quit(1);return
	start=Time.get_ticks_usec();var delta: Dictionary=preload("res://scripts/builder/document_delta.gd").between(source,generated["data"]);var delta_ms: float=(Time.get_ticks_usec()-start)/1000.0;print("COOP MEASURE delta ms: ",delta_ms)
	start=Time.get_ticks_usec();var merged: Dictionary=preload("res://scripts/builder/cooperative_merge.gd").apply(source,delta);var merge_ms: float=(Time.get_ticks_usec()-start)/1000.0;print("COOP MEASURE merge ms: ",merge_ms);check(merged["ok"] and merged["data"]==generated["data"],"Measured merge retains every purchased object, tile and setting")
	start=Time.get_ticks_usec();var old: Dictionary=Reference.apply(source,delta);var old_ms: float=(Time.get_ticks_usec()-start)/1000.0;print("COOP MEASURE archived merge ms: ",old_ms);check(old==merged,"The same-process timing comparison retains the exact historical forward result")
	var out: String="res://output/verification/asset_expansion/I16/";FileAccess.open(out+"cooperative_measurement_"+str(Time.get_unix_time_from_system()).replace(".","_")+".json",FileAccess.WRITE).store_string(JSON.stringify({"scope":"CPU-only actual minimum 2D district, archived and current merges in one process; no GUI or frame-rate guarantee","tiles":generated["data"]["tiles"].size(),"delta_ms":delta_ms,"merge_ms":merge_ms,"archived_merge_ms":old_ms,"current_sha256":FileAccess.get_sha256("res://scripts/builder/cooperative_merge.gd"),"reference_sha256":FileAccess.get_sha256(out+"cooperative_merge_before.gd")},"\t"));print("NEIGHBORHOOD COOP MEASUREMENT: %d checks, %d failures"%[checks,failures]);quit(1 if failures else 0)
