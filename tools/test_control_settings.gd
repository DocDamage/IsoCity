extends SceneTree
var checks: int=0
var failures: int=0
func check(value: bool,message: String) -> void:
	checks+=1
	if not value: failures+=1; print("FAIL: "+message)
func _initialize() -> void: call_deferred("run")
func settle() -> void:
	for i in 5: await process_frame
	await physics_frame
func key(code: int,pressed: bool=true) -> InputEventKey:
	var event:=InputEventKey.new()
	event.keycode=code & KEY_CODE_MASK
	event.ctrl_pressed=bool(code & KEY_MASK_CTRL)
	event.shift_pressed=bool(code & KEY_MASK_SHIFT)
	event.alt_pressed=bool(code & KEY_MASK_ALT)
	event.meta_pressed=bool(code & KEY_MASK_META)
	event.pressed=pressed
	return event
func send(studio: Control,code: int) -> void:
	var event: InputEventKey=key(code)
	if not studio.control_settings.input(event): studio._unhandled_key_input(event)
func capture(name: String) -> void:
	if not "--capture" in OS.get_cmdline_user_args(): return
	await settle()
	await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png("res://output/"+name+".png")
func run() -> void:
	var studio: Control=load("res://scenes/builder.tscn").instantiate()
	studio.storage_enabled=false
	root.add_child(studio)
	await settle()
	var controls: RefCounted=studio.control_settings
	check(controls.bindings.size()==controls.SPECS.size(),"Every command, movement and keyboard canvas action has a binding entry")
	for spec in controls.SPECS:
		for code in spec[3]: check(controls.match_event(key(code))==spec[0],"Default combination maps exactly: "+spec[1])
	var before: Dictionary=controls.bindings.duplicate(true)
	check(not controls.assign("undo",0,KEY_MASK_CTRL|KEY_S).is_empty() and controls.bindings==before,"Conflicts are rejected without discarding either binding")
	check(controls.assign("undo",0,KEY_F9).is_empty() and controls.match_event(key(KEY_F9))=="undo","Command can be rebound")
	check(controls.match_event(key(KEY_MASK_CTRL|KEY_Z)).is_empty(),"Original key becomes inactive after remapping")
	controls.clear_binding("undo",0)
	check(controls.label_for("undo")=="Unbound" and controls.match_event(key(KEY_F9)).is_empty(),"Bindings can be explicitly removed")
	controls.reset_defaults(false)
	check(controls.bindings==before,"Restore defaults restores all bindings")
	controls.settings_path="res://output/control_settings_test.json"
	studio.storage_enabled=true
	controls.assign("walk",0,KEY_F9)
	studio.storage_enabled=false
	var disk: Variant=studio.Store.read_json(controls.settings_path,{})
	check(disk.get("walk",[]).size()==1 and int(disk["walk"][0])==KEY_F9,"Remapping writes a separate controls preference file")
	controls.reset_defaults(false)
	controls.restore(disk)
	check(controls.match_event(key(KEY_F9))=="walk","Written preferences restore the actual remap")
	controls.reset_defaults(false)
	controls.assign("walk",0,KEY_F9)
	var saved: Dictionary=JSON.parse_string(JSON.stringify(controls.bindings))
	controls.reset_defaults(false); controls.restore(saved)
	check(controls.match_event(key(KEY_F9))=="walk","JSON preference round trip preserves remaps")
	controls.restore({"walk":[-1]})
	check(controls.match_event(key(KEY_F9))=="walk","Invalid preference values leave current bindings intact")
	controls.restore({"walk":[KEY_MASK_CTRL|KEY_S]})
	check(controls.match_event(key(KEY_F9))=="walk","Invalid preference conflicts do not replace working bindings")
	controls.restore({"walk":"Tab"})
	check(controls.match_event(key(KEY_F9))=="walk","Malformed preferences are ignored safely")
	var older: Dictionary=controls.default_bindings()
	older.erase("delivery_cargo")
	older.erase("delivery_cancel")
	older["jump"]=[KEY_H]
	older["recover"]=[KEY_MASK_SHIFT|KEY_H]
	controls.restore(older)
	check(controls.match_event(key(KEY_H))=="jump" and controls.match_event(key(KEY_MASK_SHIFT|KEY_H))=="recover" and controls.bindings["delivery_cargo"].is_empty() and controls.bindings["delivery_cancel"].is_empty(),"Delivery defaults preserve existing user remaps when loading older preferences")
	controls.reset_defaults(false)
	controls.show()
	controls.query.text="camera orbit"; controls.refresh()
	check(controls.visible_ids==["orbit_left","orbit_right"],"Reference searches across category and action words")
	controls.query.text="F10"; controls.refresh()
	check(controls.visible_ids==["focus_canvas"],"Reference searches assigned keys")
	controls.begin_capture(0)
	check(controls.input(key(KEY_F9)) and controls.capturing.is_empty() and controls.match_event(key(KEY_F9))=="focus_canvas","Key capture saves a new binding while modal")
	check("F9" in studio.workspace_presets.focus_button.text,"Visible focus button updates to the remapped key")
	controls.query.text="F9"; controls.refresh()
	controls.begin_capture(0)
	controls.input(key(KEY_MASK_CTRL|KEY_S))
	check(not controls.capturing.is_empty() and "Already used" in controls.notice.text,"Capture explains conflicts and keeps listening")
	controls.input(key(KEY_ESCAPE))
	check(controls.capturing.is_empty() and controls.match_event(key(KEY_F9))=="focus_canvas","Escape cancels capture without changing bindings")
	controls.query.text=""; controls.refresh()
	await capture("editor_controls_reference")
	controls.dialog.hide(); controls.query.release_focus()
	var focus: Control=root.gui_get_focus_owner()
	if focus: focus.release_focus()
	studio._input(key(KEY_F10))
	check(not studio.workspace_presets.focused,"Removed default global key no longer activates focus")
	studio._input(key(KEY_F9))
	check(studio.workspace_presets.focused,"Remapped global command routes through real Studio input")
	studio._input(key(KEY_F9))
	studio.search.grab_focus()
	studio._input(key(KEY_F9))
	check(not studio.workspace_presets.focused,"Typing in search suppresses global canvas shortcuts")
	studio.search.release_focus()
	controls.reset_defaults(false)
	controls.execute("asset_search")
	check(studio.search.has_focus() and studio.mode_library.visible,"Keyboard asset search reveals the library and focuses search")
	studio.category.select(0); studio.search.text="sofa teal"; studio.refresh_library()
	var first: Button=studio.cards.get_child(0)
	var preview_focus: bool=false
	for child in first.get_children():
		if child is Button and child.text=="⋯": preview_focus=child.focus_mode==Control.FOCUS_ALL
	check(first.focus_mode==Control.FOCUS_ALL and preview_focus,"Library cards and expanded previews support keyboard focus")
	var chosen: String=first.asset_id
	studio.search.text_submitted.emit(studio.search.text)
	check(studio.asset_id==chosen and not studio.search.has_focus(),"Submitting asset search chooses the first ranked result without a mouse")
	studio.search.text=""; studio.refresh_library(); studio.clear_placement()
	for mode in ["2d","3d"]:
		studio.switch_mode(mode)
		var doc: RefCounted=preload("res://scripts/builder/document.gd").new()
		doc.data=preload("res://scripts/builder/templates.gd").make(mode,"blank")
		studio.documents[mode]=doc
		studio.clear_placement()
		studio.worlds[mode].apply(doc.data)
		studio.worlds[mode].reset_camera("room")
		if mode=="3d": studio.worlds[mode].distance=12; studio.worlds[mode].target=Vector3.ZERO; studio.worlds[mode].update_camera()
		await settle()
		controls.execute("cursor_toggle")
		if not controls.cursor_active: controls.execute("cursor_toggle")
		check(controls.cursor_position==studio.canvas.size/2,"Keyboard cursor starts at visible canvas center: "+mode)
		controls.execute("cursor_right")
		check(controls.pointer().x==studio.canvas.size.x/2+16,"Keyboard cursor moves without changing OS pointer: "+mode)
		controls.execute("cursor_fine_left")
		check(controls.pointer().x==studio.canvas.size.x/2+15,"Fine cursor movement provides pixel precision: "+mode)
		studio.asset_id="2d:Sofa_Teal" if mode=="2d" else "3d:HanX_Park/Bench_Park"
		studio.direction="SE" if mode=="2d" else "0"
		studio.set_tool("place")
		controls.execute("cursor_click")
		check(doc.data["objects"].size()==1,"Keyboard cursor places an asset: "+mode)
		controls.execute("undo")
		check(doc.data["objects"].is_empty(),"Keyboard placement is undoable: "+mode)
		controls.execute("redo")
		await settle()
		var item: Dictionary=doc.data["objects"][0]
		var bounds: Rect2=studio.screen_bounds(item["uid"])
		controls.cursor_position=bounds.get_center()
		studio.set_tool("select")
		controls.execute("cursor_click")
		check(studio.selected_uid==item["uid"],"Keyboard cursor selects the placed object: "+mode)
		var original: Array=item["position"].duplicate()
		var history: int=doc.undo_history.size()
		controls.execute("cursor_drag")
		for i in 4: controls.execute("cursor_right")
		controls.execute("cursor_drag")
		check(not controls.dragging and item["position"]!=original,"Keyboard drag moves selected object: "+mode)
		check(doc.undo_history.size()==history+1,"Keyboard drag creates one undo transaction: "+mode)
		controls.execute("undo")
		check(doc.object(item["uid"])["position"]==original,"Undo restores the entire keyboard drag: "+mode)
		await settle()
		controls.cursor_position=studio.screen_bounds(item["uid"]).get_center()
		controls.execute("cursor_drag")
		for i in 4: controls.execute("cursor_right")
		controls.execute("undo")
		check(not controls.dragging and not studio.stroke and doc.object(item["uid"])["position"]==original,"Undo during keyboard drag finishes and reverses the gesture: "+mode)
		studio.set_tool("road")
		controls.cursor_position=studio.canvas.size/2
		var road_count: int=doc.data.get("roads",[]).size()
		controls.execute("cursor_drag")
		for i in 12: controls.execute("cursor_right")
		controls.execute("cursor_drag")
		check(doc.data.get("roads",[]).size()>road_count and not studio.road_drawing,"Keyboard drag draws connected roads and finishes: "+mode)
		controls.execute("undo")
		check(doc.data.get("roads",[]).size()==road_count,"One undo reverses keyboard road drawing: "+mode)
		studio.asset_id="2d:Grass"; studio.direction="SE"; studio.set_tool("place")
		studio.ground_brush.operation.select(2)
		controls.cursor_position=studio.canvas.size/2
		var surface_before: Dictionary=doc.data.duplicate(true)
		controls.execute("cursor_drag")
		for i in 5: controls.execute("cursor_right"); controls.execute("cursor_down")
		check(studio.ground_brush.drawing,"Keyboard rectangle fill remains pending until finished: "+mode)
		controls.execute("cursor_drag")
		check(doc.data!=surface_before and not studio.ground_brush.drawing,"Keyboard drag paints a ground rectangle: "+mode)
		controls.execute("undo")
		check(doc.data==surface_before,"One undo restores the ground before the keyboard fill: "+mode)
		var zoom: float=studio.worlds[mode].camera.zoom.x if mode=="2d" else studio.worlds[mode].distance
		controls.execute("zoom_in")
		check((studio.worlds[mode].camera.zoom.x>zoom if mode=="2d" else studio.worlds[mode].distance<zoom),"Keyboard zoom works: "+mode)
		controls.execute("zoom_out")
		if mode=="3d":
			var yaw: float=studio.worlds[mode].yaw
			var pitch: float=studio.worlds[mode].pitch
			controls.execute("orbit_right"); controls.execute("tilt_down")
			check(studio.worlds[mode].yaw==yaw+15 and studio.worlds[mode].pitch==minf(pitch+5,80),"Keyboard orbit and tilt replace right-drag")
		controls.clear_binding("move_right",0); controls.clear_binding("move_right",0)
		controls.assign("move_right",0,KEY_L)
		Input.parse_input_event(key(KEY_D))
		check(not controls.held("move_right") and studio.camera_movement().x==0,"Removed movement defaults stop panning: "+mode)
		Input.parse_input_event(key(KEY_D,false)); Input.parse_input_event(key(KEY_L))
		Input.flush_buffered_events()
		check(controls.held("move_right") and studio.camera_movement().x==1,"Remapped movement drives camera input: "+mode)
		check(studio.worlds[mode].player.control_input.call("move_right"),"Actual character reads remapped movement: "+mode)
		Input.parse_input_event(key(KEY_L,false))
		controls.assign("walk",0,KEY_F9)
		studio._input(key(KEY_TAB))
		check(not studio.walking,"Removed Walk shortcut stays inactive: "+mode)
		studio._input(key(KEY_F9))
		check(studio.walking and "F9" in studio.mode_badge.text,"Remapped Walk shortcut changes mode and its visible hint: "+mode)
		var player: Node=studio.worlds[mode].player
		player.set_physics_process(false)
		player.teleport_to(Vector2(200,200) if mode=="2d" else Vector3(20,0.1,20))
		studio._process(0.016)
		var start: Variant=player.position
		Input.parse_input_event(key(KEY_L)); Input.flush_buffered_events()
		for i in 12: player._physics_process(1.0/60.0)
		check(player.position.distance_to(start)>(1 if mode=="2d" else 0.05),"Remapped key moves the real walking character: "+mode)
		Input.parse_input_event(key(KEY_L,false)); Input.flush_buffered_events()
		controls.assign("recover",0,KEY_K)
		Input.parse_input_event(key(KEY_K)); Input.flush_buffered_events()
		player._physics_process(1.0/60.0)
		check(player.recover_held,"Remapped recovery key reaches the real character controller: "+mode)
		Input.parse_input_event(key(KEY_K,false)); Input.flush_buffered_events()
		player._physics_process(1.0/60.0)
		check(not player.recover_held,"Recovery release reaches the real character controller: "+mode)
		if mode=="3d":
			controls.assign("jump",0,KEY_J)
			Input.parse_input_event(key(KEY_SPACE)); Input.flush_buffered_events()
			player._physics_process(1.0/60.0)
			check(not player.jump_held,"Removed default jump key stays inactive")
			Input.parse_input_event(key(KEY_SPACE,false)); Input.parse_input_event(key(KEY_J)); Input.flush_buffered_events()
			player._physics_process(1.0/60.0)
			check(player.jump_held,"Remapped jump key reaches the real character controller")
			Input.parse_input_event(key(KEY_J,false)); Input.flush_buffered_events()
		player.set_physics_process(true)
		controls.execute("cancel")
		check(not studio.walking,"Cancel returns from walking: "+mode)
		controls.reset_defaults(false)
		controls.persist()
		await capture("editor_keyboard_canvas_"+mode)
	controls.show(); controls.query.text="zzzz no match"; controls.refresh()
	check(controls.rows.item_count==0 and controls.bind_buttons[0].disabled,"No-match reference disables capture")
	controls.dialog.hide(); controls.query.release_focus()
	root.size=Vector2i(960,640)
	await settle()
	controls.show()
	await settle()
	check(controls.dialog.size.x<=960 and controls.dialog.size.y<=640,"Controls reference fits minimum window size")
	await capture("editor_controls_small")
	studio.queue_free(); await process_frame
	print("CONTROL SETTINGS: %d checks, %d failures" % [checks,failures])
	quit(0 if failures==0 else 1)
