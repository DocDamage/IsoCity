extends SceneTree
const Rotation=preload("res://scripts/builder/rotation.gd")
var checks: int=0
var failures: int=0
var studio: Control
var gizmo: RefCounted
func check(value: bool,message: String) -> void:
	checks+=1
	if not value: failures+=1; print("FAIL: "+message)
func _initialize() -> void: call_deferred("run")
func settle() -> void:
	for i in 5: await process_frame
	await physics_frame
func capture(name: String) -> void:
	if not "--capture" in OS.get_cmdline_user_args(): return
	await settle(); await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png("res://output/"+name+".png")
func select(ids: Array) -> void:
	studio.selected_uids.clear()
	for id in ids: studio.selected_uids.append(id)
	studio.selected_uid=ids[0] if not ids.is_empty() else ""
	studio.set_tool("select"); studio.refresh_controls(); gizmo.tick()
func button(at: Vector2,pressed: bool,right: bool=false) -> void:
	var event:=InputEventMouseButton.new(); event.position=at; event.button_index=MOUSE_BUTTON_RIGHT if right else MOUSE_BUTTON_LEFT; event.pressed=pressed
	studio._canvas_input(event)
func motion(at: Vector2) -> void:
	var event:=InputEventMouseMotion.new(); event.position=at; event.button_mask=MOUSE_BUTTON_MASK_LEFT
	studio._canvas_input(event)
func handle(axis: int) -> Dictionary:
	gizmo.tick()
	for item in gizmo.handles:
		if item["axis"]==axis: return item.duplicate(true)
	return {}
func drag(h: Dictionary,delta: Vector2) -> void:
	button(h["end"],true); motion(h["end"]+delta); button(h["end"]+delta,false)
func pos(item: Dictionary) -> Vector3: return Vector3(item["position"][0],item["position"][1],item["position"][2])
func basis(item: Dictionary) -> Basis: return Basis.from_euler(Rotation.euler(item)*PI/180)
func run() -> void:
	root.size=Vector2i(1480,900)
	studio=load("res://scenes/builder.tscn").instantiate(); studio.storage_enabled=false; root.add_child(studio); await settle()
	gizmo=studio.transform_handles
	for mode in ["2d","3d"]:
		studio.switch_mode(mode)
		var doc: RefCounted=preload("res://scripts/builder/document.gd").new()
		doc.data=preload("res://scripts/builder/templates.gd").make(mode,"blank")
		studio.documents[mode]=doc
		var a: Dictionary=doc.add("2d:Park_Bench" if mode=="2d" else "3d:HanX_Park/Bench_Park",[0,0,0],"SE" if mode=="2d" else "35")
		var b: Dictionary=doc.add("3d:HanX_Park/Bench_Park" if mode=="2d" else "2d:Sofa_Teal",[96,0,0] if mode=="2d" else [3,0,0],"15" if mode=="2d" else "SE",2)
		var aid: String=a["uid"]; var bid: String=b["uid"]
		studio.clear_placement(); studio.worlds[mode].apply(doc.data); studio.worlds[mode].reset_camera("room")
		studio.arrange_tools.pivot_mode.select(0); studio.snap_input.button_pressed=false
		select([aid]); gizmo.set_mode("move"); gizmo.frame_handles(); await settle()
		check(gizmo.handles.size()==3,"Move offers three labeled coordinate constraints: "+mode)
		await capture("editor_handles_move_"+mode)
		for axis in 3:
			select([aid]); gizmo.set_mode("move"); gizmo.frame_handles(); await settle()
			var h: Dictionary=handle(axis)
			var original: Vector3=pos(doc.object(aid))
			var history: int=doc.undo_history.size()
			var distance: float=([21.0,13.0,1.5][axis] if mode=="2d" else [1.5,.75,2.0][axis])
			button(h["end"],true)
			check(gizmo.dragging and gizmo.active["axis"]==axis,"Canvas hit chooses the labeled move axis: "+mode+str(axis))
			motion(h["end"]+h["vector"]*distance*.5); gizmo.tick(); motion(h["end"]+h["vector"]*distance)
			if axis==0: await capture("editor_handles_drag_"+mode)
			button(h["end"]+h["vector"]*distance,false)
			var expected: Vector3=original; expected[axis]+=distance
			check(pos(doc.object(aid)).is_equal_approx(expected),"Move changes only its constrained coordinate without cumulative drift: "+mode+str(axis))
			check(doc.undo_history.size()==history+1,"Entire handle drag records one undo change: "+mode+str(axis))
			studio._command("undo",null)
			check(pos(doc.object(aid)).is_equal_approx(original),"Undo restores constrained movement: "+mode+str(axis))
			studio._command("redo",null)
			check(pos(doc.object(aid)).is_equal_approx(expected),"Redo restores constrained movement: "+mode+str(axis))
			studio._command("undo",null)
		select([aid]); gizmo.frame_handles(); await settle()
		var h: Dictionary=handle(0)
		var before: Dictionary=doc.data.duplicate(true)
		var undo_count: int=doc.undo_history.size(); var redo_count: int=doc.redo_history.size()
		button(h["end"],true); motion(h["end"]+h["vector"]*(12 if mode=="2d" else 1))
		studio.control_settings.execute("cancel")
		check(not gizmo.dragging and doc.data==before,"Escape/cancel restores original transforms: "+mode)
		check(doc.undo_history.size()==undo_count and doc.redo_history.size()==redo_count,"Cancel preserves both history stacks: "+mode)
		button(h["end"],true); button(h["end"],false)
		check(doc.data==before and doc.undo_history.size()==undo_count and doc.redo_history.size()==redo_count,"Clicking a handle without movement creates no edit: "+mode)
		button(gizmo.label_rect(h).get_center(),true)
		check(gizmo.dragging,"Text labels are part of the clickable handle: "+mode)
		button(gizmo.label_rect(h).get_center(),false)
		check(doc.data==before,"Labeled handle hit areas can be clicked without changing transforms: "+mode)
		studio.snap_input.button_pressed=true
		select([aid]); h=handle(0); drag(h,h["vector"]*(23 if mode=="2d" else 1.7))
		check(is_equal_approx(pos(doc.object(aid)).x,32 if mode=="2d" else 2),"Axis snapping uses a constrained increment that retains the tile lattice: "+mode)
		studio._command("undo",null); studio.snap_input.button_pressed=false
		select([aid]); gizmo.set_mode("rotate"); gizmo.frame_handles(); await settle()
		await capture("editor_handles_rotate_"+mode)
		for axis in ([2] if mode=="2d" else [0,1,2]):
			select([aid]); gizmo.set_mode("rotate"); gizmo.frame_handles(); await settle()
			if mode=="3d": doc.object(aid)["tilt"]=[13,-11]; studio.changed(); gizmo.tick()
			var ring: Dictionary=handle(axis)
			check(not ring.is_empty(),"World rotation axis is projected as a usable ring: "+mode+str(axis))
			var original: Dictionary=doc.object(aid).duplicate(true)
			var history: int=doc.undo_history.size()
			button(ring["end"],true)
			check(gizmo.dragging and gizmo.active["axis"]==axis,"Ring hit selects the intended rotation constraint: "+mode+str(axis))
			var angle: float=gizmo.last_angle+deg_to_rad(30)
			var radius: float=(ring["end"]-gizmo.origin).length()/(ring["u"]*cos(gizmo.last_angle)+ring["v"]*sin(gizmo.last_angle)).length()
			var end: Vector2=gizmo.origin+(ring["u"]*cos(angle)+ring["v"]*sin(angle))*radius
			motion(end); button(end,false)
			if mode=="2d": check(is_equal_approx(Rotation.heading(doc.object(aid),studio.library),Rotation.heading(original,studio.library)+30),"2D heading handle turns clockwise in canvas space")
			else:
				var expected: Basis=Basis(gizmo.AXES[axis],deg_to_rad(30))*basis(original)
				var actual: Basis=basis(doc.object(aid))
				check(actual.x.distance_to(expected.x)<.0003 and actual.y.distance_to(expected.y)<.0003 and actual.z.distance_to(expected.z)<.0003,"Rotation applies around the actual world axis while preserving existing tilt: "+str(axis))
			check(doc.undo_history.size()==history+1,"Rotation ring gesture is one undo step: "+mode+str(axis))
			studio._command("undo",null)
			check(doc.object(aid)==original,"Undo restores full original orientation: "+mode+str(axis))
		select([aid,bid]); studio.arrange_tools.pivot_mode.select(0); gizmo.set_mode("resize"); gizmo.frame_handles(); await settle()
		var old_a: Dictionary=doc.object(aid).duplicate(true); var old_b: Dictionary=doc.object(bid).duplicate(true)
		var pivot: Vector3=studio.arrange_tools.pivot(studio.selection_items())
		h=handle(-1)
		drag(h,Vector2(1,-1).normalized()*log(1.5)*110)
		check(is_equal_approx(doc.object(aid)["scale"],old_a["scale"]*1.5) and is_equal_approx(doc.object(bid)["scale"],old_b["scale"]*1.5),"Uniform resizing preserves mixed selections' size ratios: "+mode)
		check(pos(doc.object(aid)).is_equal_approx(pivot+(pos(old_a)-pivot)*1.5) and pos(doc.object(bid)).is_equal_approx(pivot+(pos(old_b)-pivot)*1.5),"Group resizing uses the chosen pivot: "+mode)
		await capture("editor_handles_resize_"+mode)
		studio._command("undo",null)
		check(doc.object(aid)==old_a and doc.object(bid)==old_b,"Undo restores the complete group resize: "+mode)
		select([aid,bid]); studio.arrange_tools.pivot_mode.select(1); gizmo.set_mode("resize"); gizmo.frame_handles(); await settle()
		h=handle(-1); drag(h,Vector2(1,-1).normalized()*log(1.25)*110)
		check(pos(doc.object(aid))==pos(old_a) and pos(doc.object(bid))==pos(old_b),"Individual-origin resizing leaves object positions fixed: "+mode)
		studio._command("undo",null)
		select([aid,bid]); studio.arrange_tools.set_custom([20,10,0] if mode=="2d" else [.5,0,.5]); gizmo.set_mode("rotate"); gizmo.frame_handles(); await settle()
		var old_first: Dictionary=doc.object(aid).duplicate(true); var old_second: Dictionary=doc.object(bid).duplicate(true)
		var custom: Vector3=studio.arrange_tools.pivot(studio.selection_items())
		var ring: Dictionary=handle(2 if mode=="2d" else 1)
		button(ring["end"],true)
		var theta: float=gizmo.last_angle+deg_to_rad(30)
		var r: float=(ring["end"]-gizmo.origin).length()/(ring["u"]*cos(gizmo.last_angle)+ring["v"]*sin(gizmo.last_angle)).length()
		var endpoint: Vector2=gizmo.origin+(ring["u"]*cos(theta)+ring["v"]*sin(theta))*r
		motion(endpoint); button(endpoint,false)
		if mode=="2d":
			var values: Array=Rotation.orbit_position(old_first["position"],custom,30,"2d")
			check(pos(doc.object(aid)).distance_to(Vector3(values[0],values[1],values[2]))<.001,"Mixed group rotation orbits the custom pivot in isometric space")
			check(is_equal_approx(Rotation.heading(doc.object(bid),studio.library),wrapf(Rotation.heading(old_second,studio.library)-30,0,360)),"Model headings follow the same visible turn as sprites in 2D")
		else:
			check(pos(doc.object(aid)).distance_to(custom+(pos(old_first)-custom).rotated(Vector3.UP,deg_to_rad(30)))<.001,"Mixed group rotation orbits the selected world pivot")
			check(basis(doc.object(bid)).x.distance_to((Basis(Vector3.UP,deg_to_rad(30))*basis(old_second)).x)<.0003,"Flat sprites follow constrained world rotation alongside models")
		studio._command("undo",null)
		check(doc.object(aid)==old_first and doc.object(bid)==old_second,"Custom-pivot rotation is completely undoable: "+mode)
		studio.arrange_tools.pivot_mode.select(0)
		select([aid]); gizmo.set_mode("move"); gizmo.frame_handles(); await settle()
		h=handle(0)
		studio.control_settings.cursor_active=true; studio.control_settings.cursor_position=h["end"]
		studio.control_settings.execute("cursor_drag"); studio.control_settings.execute("cursor_right"); studio.control_settings.execute("cursor_drag")
		check(not gizmo.dragging and not studio.control_settings.dragging and doc.object(aid)!=old_first,"Keyboard canvas dragging can operate a transform handle: "+mode)
		studio._command("undo",null); studio.control_settings.cursor_active=false
		check(doc.object(aid)==old_first,"Keyboard handle movement shares normal undo: "+mode)
		doc.object(aid)["locked"]=true; studio.changed(); select([aid,bid]); gizmo.frame_handles(); await settle()
		var protected_position: Vector3=pos(doc.object(aid)); var editable_position: Vector3=pos(doc.object(bid))
		h=handle(0); drag(h,h["vector"]*(16 if mode=="2d" else 1))
		check(pos(doc.object(aid))==protected_position and pos(doc.object(bid))!=editable_position,"Mixed selections transform only editable objects: "+mode)
		studio._command("undo",null); doc.object(aid).erase("locked"); studio.changed()
		select([aid]); doc.object(aid)["position"][0]=999999.0; studio.changed(); gizmo.frame_handles(); await settle()
		h=handle(0); drag(h,h["vector"]*32)
		check(doc.object(aid)["position"][0]==1000000.0,"Constrained movement respects the supported coordinate range: "+mode)
		studio._command("undo",null); doc.object(aid)["position"]=old_first["position"].duplicate(); studio.changed()
		select([aid,bid]); doc.object(aid)["scale"]=.1; doc.object(bid)["scale"]=8; studio.changed(); gizmo.set_mode("resize"); gizmo.frame_handles(); await settle()
		var history: int=doc.undo_history.size()
		h=handle(-1); drag(h,Vector2(500,-500))
		check(doc.object(aid)["scale"]==.1 and doc.object(bid)["scale"]==8 and doc.undo_history.size()==history,"Scale limits preserve ratios without an impossible partial resize: "+mode)
		doc.object(aid)["scale"]=1; doc.object(bid)["scale"]=2; studio.changed()
		select([aid]); gizmo.set_mode("move"); gizmo.frame_handles(); await settle()
		h=handle(0); before=doc.data.duplicate(true); history=doc.undo_history.size()
		button(h["end"],true); motion(h["end"]+h["vector"]*(20 if mode=="2d" else 1)); button(h["end"],true,true)
		check(doc.data==before and not gizmo.dragging and doc.undo_history.size()==history,"Right-click cancels without starting camera orbit: "+mode)
		button(h["end"],true); motion(h["end"]+h["vector"]*(20 if mode=="2d" else 1))
		doc.object(aid)["locked"]=true; gizmo.tick()
		check(not gizmo.dragging and pos(doc.object(aid))==pos(before["objects"][0]) and doc.object(aid)["locked"],"Protection changes cancel the gesture while preserving the new lock: "+mode)
		check(gizmo.handles.is_empty(),"Locked selections do not expose editable handles: "+mode)
		doc.object(aid).erase("locked"); studio.changed(); select([aid]); gizmo.frame_handles(); await settle()
		h=handle(0); button(h["end"],true); motion(h["end"]+h["vector"]*(20 if mode=="2d" else 1))
		doc.data["objects"].erase(doc.object(aid)); gizmo.tick()
		check(not gizmo.dragging and doc.object(aid).is_empty(),"Deleted targets are never resurrected by stale-handle cancellation: "+mode)
		select([bid]); gizmo.set_mode("rotate"); studio.capture_workspace()
		check(studio.workspace[mode]["handles"]["mode"]=="rotate","Handle mode is captured with this world's workspace: "+mode)
		var ground: Dictionary=doc.add("2d:Grass",[0,0,0],"SE")
		studio.changed(); select([ground["uid"]]); gizmo.set_mode("rotate"); gizmo.frame_handles(); await settle()
		check(gizmo.handles.size()==1,"Ground objects expose their supported heading constraint: "+mode)
		ring=handle(2 if mode=="2d" else 1); button(ring["end"],true)
		theta=gizmo.last_angle+deg_to_rad(80)
		r=(ring["end"]-gizmo.origin).length()/(ring["u"]*cos(gizmo.last_angle)+ring["v"]*sin(gizmo.last_angle)).length()
		endpoint=gizmo.origin+(ring["u"]*cos(theta)+ring["v"]*sin(theta))*r
		motion(endpoint); button(endpoint,false)
		check(is_equal_approx(Rotation.heading(doc.object(ground["uid"]),studio.library),90),"Ground rotation retains quarter turns: "+mode)
		studio._command("undo",null)
		check(doc.object(ground["uid"])["direction"]=="SE","Ground handle rotation is undoable: "+mode)
		select([bid]); gizmo.set_mode("resize")
		var path: String="res://output/handles_"+mode+".isocity.json"
		var expected_objects: Array=doc.data["objects"].duplicate(true)
		check(studio.write_project(path),"Handle edits can be saved through the normal project writer: "+mode)
		gizmo.set_mode("off")
		check(studio.load_project(path) and gizmo.mode=="resize","Project reopening restores the per-world handle mode: "+mode)
		var restored: bool=studio.current().data["objects"].size()==expected_objects.size()
		for item in expected_objects:
			var actual: Dictionary=studio.current().object(item["uid"])
			restored=restored and not actual.is_empty() and pos(actual).is_equal_approx(pos(item)) and is_equal_approx(actual["scale"],item["scale"]) and actual["direction"]==item["direction"] and basis(actual).is_equal_approx(basis(item))
		check(restored,"Saved handle transforms survive project reopening: "+mode)
	var doc: RefCounted=studio.current()
	var uid: String=doc.data["objects"][0]["uid"]
	select([uid]); gizmo.set_mode("rotate"); studio.worlds["3d"].yaw=0; studio.worlds["3d"].update_camera(); gizmo.frame_handles(); await settle()
	check(gizmo.handles.all(func(h: Dictionary): return h["axis"]!=0) and "edge-on" in gizmo.note.text,"Edge-on rotation planes are disabled with an orbit explanation")
	studio.worlds["3d"].yaw=45; studio.worlds["3d"].update_camera(); gizmo.tick()
	check(not handle(0).is_empty(),"Orbiting restores a projected rotation ring")
	gizmo.set_mode("move"); gizmo.frame_handles(); await settle()
	var old: Dictionary=doc.object(uid).duplicate(true)
	var h: Dictionary=handle(0); var history: int=doc.undo_history.size()
	button(h["end"],true); motion(h["end"]+h["vector"])
	studio._command("undo",null)
	check(not gizmo.dragging and doc.object(uid)==old and doc.undo_history.size()==history,"Undo during a handle drag commits and reverses exactly that gesture")
	select([uid]); gizmo.frame_handles(); await settle(); h=handle(0)
	button(h["end"],true); motion(h["end"]+h["vector"])
	check(studio.write_project("res://output/handles_active.isocity.json") and not gizmo.dragging,"Explicit saving finalizes an active handle edit")
	var written: Dictionary=studio.Store.read_json("res://output/handles_active.isocity.json",{})
	var saved: Array=written["documents"]["3d"]["objects"]
	check(saved.any(func(item: Dictionary): return item["uid"]==uid and pos(item).is_equal_approx(pos(doc.object(uid)))),"The saved file contains the final handle transform")
	select([uid]); gizmo.frame_handles(); await settle(); h=handle(0); history=doc.undo_history.size()
	button(h["end"],true); motion(h["end"]+h["vector"]*.5)
	studio.switch_mode("2d")
	check(not gizmo.dragging and doc.undo_history.size()==history+1,"World switching finalizes the old world's handle edit")
	var guide: RefCounted=studio.first_build
	var bench: Dictionary=studio.current().add("2d:Park_Bench",[0,0,0],"SE"); studio.changed()
	select([bench["uid"]]); gizmo.set_mode("rotate"); gizmo.frame_handles(); await settle()
	guide.guide_mode="2d"; guide.document=studio.current(); guide.uid=bench["uid"]; guide.phase=2; guide.before_rotation=guide.pose(bench)
	h=handle(2); button(h["end"],true)
	var theta: float=gizmo.last_angle+deg_to_rad(30)
	var r: float=(h["end"]-gizmo.origin).length()/(h["u"]*cos(gizmo.last_angle)+h["v"]*sin(gizmo.last_angle)).length()
	motion(gizmo.origin+(h["u"]*cos(theta)+h["v"]*sin(theta))*r); guide.tick()
	check(guide.phase==2,"The guided build does not credit an unfinished rotation drag")
	gizmo.cancel(); guide.tick()
	check(guide.phase==2 and guide.pose(bench)==guide.before_rotation,"Cancelling a handle keeps the guide's Rotate step actionable")
	guide.close()
	gizmo.restore({"mode":"not-a-mode"}); check(gizmo.mode=="move","Malformed handle settings retain a usable mode")
	studio.switch_mode("2d"); select([studio.current().data["objects"][0]["uid"]]); gizmo.set_mode("move"); gizmo.frame_handles(); await settle()
	root.size=Vector2i(960,640); await settle(); gizmo.frame_handles(); await settle()
	check(gizmo.handles.size()==3 and gizmo.handles.all(func(h: Dictionary): return Rect2(Vector2.ZERO,studio.canvas.size).has_point(h["end"])),"Handles adapt to the minimum-size canvas")
	await capture("editor_handles_small")
	studio.accessibility_settings.restore({"large_targets":true,"high_contrast":true,"text_scale":1.5}); await settle(); gizmo.frame_handles(); await settle()
	check(gizmo.radius()==22,"Accessibility expands handle hit areas to 44 pixels")
	studio.workspace_presets.set_focus(true); await settle(); gizmo.frame_handles(); await settle()
	h=handle(0)
	check(not gizmo.hit(h["end"]+h["vector"].normalized().orthogonal()*19).is_empty(),"Enlarged handle targets accept clicks beyond the normal target radius")
	check(studio.canvas.get_global_rect().intersection(Rect2(Vector2.ZERO,root.size)).size.y>280,"Enlarged handles remain visible in a focused minimum-size canvas")
	check(studio.control_settings.assign("handles_rotate",0,KEY_K).is_empty(),"The fixture assigns a free rotation shortcut")
	var key:=InputEventKey.new(); key.keycode=KEY_K; key.pressed=true; studio._unhandled_key_input(key)
	check(gizmo.mode=="rotate","Handle modes can be assigned and activated through remappable controls")
	gizmo.set_mode("move")
	await capture("editor_handles_accessible")
	studio.queue_free(); await process_frame
	print("TRANSFORM HANDLES: %d checks, %d failures" % [checks,failures])
	quit(0 if failures==0 else 1)
