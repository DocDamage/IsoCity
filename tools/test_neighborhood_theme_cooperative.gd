extends "res://tools/test_collection_cooperative.gd"
const Neighborhood=preload("res://scripts/builder/neighborhood_plan.gd")
const EVIDENCE="res://output/verification/asset_expansion/I16/"
func select_theme(ui: RefCounted,id: String) -> void:
	for index in ui.theme.item_count:
		if ui.theme.get_item_metadata(index)==id:ui.theme.select(index);ui.theme.item_selected.emit(index);return
	check(false,"Reviewed theme is exposed through the actual shared editor")
func prepare(studio: Control,theme: String,origin: Vector2i) -> bool:
	var ui: RefCounted=studio.neighborhood_tools;print("DISTRICT COOP: opening ",theme);studio._command("neighborhood",null);print("DISTRICT COOP: opened");select_theme(ui,theme);ui.blocks.value=1;ui.density.value=100;ui.seed_input.value=17;ui.origin_x.value=origin.x;ui.origin_z.value=origin.y;print("DISTRICT COOP: generating");ui.generate();print("DISTRICT COOP: generated ",not ui.pending.is_empty())
	var settled: bool=await wait_until(func():return ui.pending.is_empty() or ui.preview_ready);print("DISTRICT COOP: preview ready ",ui.preview_ready);return settled
func run() -> void:
	DirAccess.make_dir_recursive_absolute(EVIDENCE);host=load("res://scenes/builder.tscn").instantiate();guest=load("res://scenes/builder.tscn").instantiate()
	for studio in [host,guest]:studio.storage_enabled=false;root.add_child(studio)
	check(await wait_until(func():return host.enhancements_ready and guest.enhancements_ready and host.consumer_shell!=null and guest.consumer_shell!=null),"Both real editors initialize for shared district authoring")
	print("DISTRICT COOP: editors ready")
	for studio in [host,guest]:
		studio.consumer_shell.dismiss_welcome()
		for mode in ["2d","3d"]:
			var data: Dictionary=preload("res://scripts/builder/templates.gd").make(mode,"blank");data["economy"]={"enabled":true,"starting_cash":1000000};data["economy_account"]=Neighborhood.Economy.fresh_account(data,studio.library);studio.documents[mode].data=data;studio.economy_tools.pauses[mode]=true
		studio.changed()
	var a: RefCounted=host.cooperative_tools;var b: RefCounted=guest.cooperative_tools;a.name_field.text="District host";a.password.text="district-test";a.port.value=0;a.host_game();b.name_field.text="District guest";b.password.text="district-test";b.address.text="127.0.0.1";b.port.value=a.session.server.get_local_port();b.join_game();check(await wait_until(func():return a.participating and b.participating and synced()),"Explicit Host and Join converge both funded worlds")
	print("DISTRICT COOP: joined")
	for mode in ["2d","3d"]:
		print("DISTRICT COOP: begin ",mode)
		host.switch_mode(mode);guest.switch_mode(mode);await settle();a.select_owner("host");a.area_name.text="Protected district";a.add_bounds(Rect2(-4,-4,88,88));check(await wait_until(synced),"Host assigns actual protection over the proposed district: "+mode);check(await prepare(guest,"village",Vector2i.ZERO) and not guest.neighborhood_tools.pending.is_empty(),"Guest can review the full private themed proposal on protected land: "+mode)
		var accepted: Dictionary=a.session.data.duplicate(true);b.failed_edit=false;guest.neighborhood_tools.commit();check(await wait_until(func():return b.failed_edit and synced()),"Host authority rejects the protected district as one transaction: "+mode);check(a.session.data==accepted and b.draft.get(mode,{}).get("objects",[]).size()>=4 and a.session.data[mode]["economy_account"]["cash"]==1000000,"Rejection keeps accepted geometry/treasury intact and retains a complete guest draft: "+mode)
		a.remove_area();check(await wait_until(synced),"Host explicitly removes ownership protection before construction: "+mode);var initial: Dictionary=a.session.data.duplicate(true);check(await prepare(guest,"village",Vector2i.ZERO),"Permitted district preview completes normally: "+mode);var expected: Dictionary=guest.neighborhood_tools.pending["data"].duplicate(true);guest.neighborhood_tools.commit();check(await wait_until(synced),"Guest district purchase is accepted and converges through ordinary co-op: "+mode);var completed: Dictionary=a.session.data.duplicate(true);check(normalized(completed[mode])==normalized(expected) and completed[mode]["objects"].all(func(item: Dictionary):return item.has("neighborhood_palette_selection")) and completed[mode]["economy_account"]["cash"]<1000000,"Both peers retain exact families, appearances, scenery and the once-only construction charge: "+mode)
		guest._command("undo",null);check(await wait_until(func():return synced() and a.session.data==initial),"Shared Undo removes all district geometry and restores its treasury: "+mode);guest._command("redo",null);check(await wait_until(func():return synced() and a.session.data==completed),"Shared Redo restores exact selected appearances and the original charge: "+mode)
		check(await prepare(guest,"hanx_modern",Vector2i(12,0)),"A distinct district preview is ready before required-asset rejection: "+mode);var proposal: Dictionary=guest.neighborhood_tools.pending["data"].duplicate(true);var id: String=proposal["objects"][completed[mode]["objects"].size()]["asset"];var peer: Dictionary=a.session.peers[b.session.local_id];peer["assets"].erase(id);accepted=a.session.data.duplicate(true);b.failed_edit=false;guest.neighborhood_tools.commit();check(await wait_until(func():return b.failed_edit and synced()),"Authority rejects a genuinely required selected source absent from the advertised peer library: "+mode);check(a.session.data==accepted and b.draft.get(mode,{}).get("objects",[]).size()>accepted[mode]["objects"].size(),"Missing-source rejection keeps the full proposal draft and accepted account: "+mode);peer["assets"][id]=true
		check(await prepare(guest,"hanx_modern",Vector2i(12,0)),"Restored required source allows a fresh review: "+mode);check(normalized(guest.neighborhood_tools.pending["data"])==normalized(proposal),"Retry preserves deterministic concrete design and scenery choices: "+mode);guest.neighborhood_tools.commit();check(await wait_until(synced),"Retry after source restoration commits normally: "+mode);check(host.write_project(EVIDENCE+"shared_district_"+mode+".isocity.json"),"Shared curated districts save through the normal project command: "+mode)
	b.leave();a.leave();host.free();guest.free();await process_frame;await process_frame;print("NEIGHBORHOOD THEME COOPERATIVE: %d checks, %d failures"%[checks,failures]);quit(1 if failures else 0)
